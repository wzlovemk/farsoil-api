# Copy to .dev.vars (ignored by git) for local Worker development.
AUCTION_CORS_ORIGINS=https://play.farsoil.com
AUTH_PUBLIC_ORIGIN=https://api.farsoil.com
AUTH_CLIENT_RETURN_ORIGIN=https://play.farsoil.com
AUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id
AUTH_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional while Steam sync remains disabled in config.
# STEAM_APP_ID=
# STEAM_PUBLISHER_KEY=
# Optional Worker replacement for Node's AUCTION_DROP_CONFIG_FILE.
# AUCTION_DROP_CONFIG_JSON={"schemaVersion":1,...}
