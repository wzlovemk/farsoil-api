{
  "name": "farsoil-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "dev:local": "node --env-file=.env --watch --experimental-strip-types src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:built": "node dist/main.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "drop:preflight": "node --experimental-strip-types scripts/drop-preflight.mjs --validate",
    "drop:release-check": "node --experimental-strip-types scripts/drop-preflight.mjs --release"
  },
  "dependencies": {
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "typescript": "^7.0.2"
  }
}
