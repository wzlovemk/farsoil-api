# Copy to .env (ignored by git) for the preserved Node/Fastify runtime.
# Google Cloud OAuth Web Application redirect URI:
# http://127.0.0.1:3001/api/v1/auth/callback
AUCTION_HOST=api.farsoil.com
AUCTION_PORT=80
AUCTION_CORS_ORIGINS=https://play.farsoil.com
# Optional Node-only server drop config file (read at startup).
# AUCTION_DROP_CONFIG_FILE=/app/config/event-drops.production.json
AUTH_PUBLIC_ORIGIN=https://api.farsoil.com
AUTH_CLIENT_RETURN_ORIGIN=https://play.farsoil.com
AUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id
AUTH_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional Steam achievement synchronization credentials.
# STEAM_APP_ID=
# STEAM_PUBLISHER_KEY=
