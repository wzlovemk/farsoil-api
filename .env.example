# Copy to server/auction/.env (ignored by git).
# Google Cloud OAuth Web Application redirect URI:
# http://127.0.0.1:3001/api/v1/auth/callback
AUCTION_HOST=127.0.0.1
AUCTION_PORT=3001
AUCTION_CORS_ORIGINS=http://127.0.0.1:5173
# Optional server-only drop config file (read at startup); use a read-only deployment mount.
# AUCTION_DROP_CONFIG_FILE=/app/config/event-drops.production.json
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:3001
AUTH_CLIENT_RETURN_ORIGIN=http://127.0.0.1:5173
AUTH_GOOGLE_CLIENT_ID=replace-with-google-web-oauth-client-id
AUTH_GOOGLE_CLIENT_SECRET=replace-with-rotated-server-only-secret
